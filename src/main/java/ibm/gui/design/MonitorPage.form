<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="ibm.gui.design.MonitorPage">
  <grid id="fdbf" binding="panel1" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="a1c78" binding="tabbedPane1" default-binding="true">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="200" height="200"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <splitpane id="e3b1f" binding="graphsPane">
            <constraints>
              <tabbedpane title="Both Charts"/>
            </constraints>
            <properties>
              <continuousLayout value="true"/>
              <dividerLocation value="250"/>
              <dividerSize value="4"/>
              <enabled value="true"/>
              <name value="Both Graphs"/>
              <oneTouchExpandable value="true"/>
              <orientation value="1"/>
            </properties>
            <border type="none"/>
            <children>
              <grid id="78c3d" binding="arppCont" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <splitpane position="left"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="fb39" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Arterial Reservoir Pressure Plot"/>
                      <verticalTextPosition value="1"/>
                    </properties>
                  </component>
                </children>
              </grid>
              <grid id="79e5" binding="bppCont" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints>
                  <splitpane position="right"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="b001b" class="javax.swing.JLabel">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <text value="Blood Pressure Plot"/>
                      <verticalTextPosition value="1"/>
                    </properties>
                  </component>
                </children>
              </grid>
            </children>
          </splitpane>
          <grid id="2ed45" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="Reservoir Pressure Chart"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="e0cf8" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="Blood Pressure Chart"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </tabbedpane>
      <toolbar id="f5a39">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false">
            <preferred-size width="-1" height="20"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="52ea6" class="javax.swing.JLabel" binding="patientNameLabel">
            <constraints/>
            <properties>
              <text value="Patient Name"/>
            </properties>
          </component>
          <hspacer id="79d0b">
            <constraints/>
          </hspacer>
          <component id="eb471" class="javax.swing.JButton" binding="playButton">
            <constraints/>
            <properties>
              <iconTextGap value="2"/>
              <inheritsPopupMenu value="true"/>
              <label value=""/>
              <maximumSize width="25" height="25"/>
              <minimumSize width="25" height="25"/>
              <preferredSize width="25" height="25"/>
              <text value=""/>
              <toolTipText value="Start Waveform Plotting"/>
            </properties>
          </component>
          <component id="3b40b" class="javax.swing.JButton" binding="stopButton">
            <constraints/>
            <properties>
              <maximumSize width="25" height="25"/>
              <minimumSize width="25" height="25"/>
              <preferredSize width="25" height="25"/>
              <text value=""/>
              <toolTipText value="Stop WaveForm Plotting"/>
            </properties>
          </component>
          <component id="490da" class="javax.swing.JToolBar$Separator">
            <constraints/>
            <properties/>
          </component>
          <component id="64e6f" class="javax.swing.JButton" binding="button3" default-binding="true">
            <constraints/>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
          <component id="175b2" class="javax.swing.JButton" binding="button4" default-binding="true">
            <constraints/>
            <properties>
              <text value="Button"/>
            </properties>
          </component>
        </children>
      </toolbar>
    </children>
  </grid>
</form>
